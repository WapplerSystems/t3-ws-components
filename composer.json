{
    "name": "wapplersystems/ws-components",
    "type": "typo3-cms-extension",
    "description": "Modular SCSS and JS component loader for TYPO3 — extensions request a key, the active site package maps it to files, scss is compiled per key, js is enqueued via AssetCollector.",
    "keywords": ["TYPO3", "scss", "javascript", "components", "modular"],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Sven Wappler",
            "email": "typo3@wappler.systems",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "typo3/cms-core": "^14.0",
        "typo3/cms-frontend": "^14.0",
        "typo3/cms-fluid": "^14.0",
        "wapplersystems/ws-scss": "*"
    },
    "autoload": {
        "psr-4": {
            "WapplerSystems\\WsComponents\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ws_components"
        }
    }
}
